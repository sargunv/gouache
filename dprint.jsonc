{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "oxc": {
    "sortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  "exec": {
    "commands": [{ "command": "rustfmt --edition 2024", "exts": ["rs"] }],
  },
  "excludes": [
    "dist",
    "site",
    ".cache",
    "target",
    "**/pnpm-lock.yaml",
    "demo/web/pkg",
  ],
  "plugins": [
    "npm:@dprint/oxc@0.51.0",
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d",
    "npm:@dprint/ruff@0.12.2",
  ],
}
